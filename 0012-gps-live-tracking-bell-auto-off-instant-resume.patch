+
+/** Minutes-ahead arithmetic for GPS ETAs: remaining km / speed. */
+export function gpsEtaFor(kmAway, speedKmph, now = new Date()) {
+  if (kmAway == null || !speedKmph || speedKmph <= 0) return null;
