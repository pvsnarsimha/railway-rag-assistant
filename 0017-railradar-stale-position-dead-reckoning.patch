diff --git a/backend/quick_live.py b/backend/quick_live.py
index 4c2969f..9d0fd44 100644
--- a/backend/quick_live.py
+++ b/backend/quick_live.py
@@ -272,3 +272,128 @@ def railradar_status(train_number: str, date_ddmmyyyy: Optional[str] = None) ->
